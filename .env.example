# ---- Web app (compile-time, read by `dx serve` / `dx bundle`; set the same in Vercel) ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx   # or the legacy "anon" key

# ---- Explainer worker (never expose these to the browser) ----
# SUPABASE_URL is shared with the web app.
SUPABASE_SECRET_KEY=sb_secret_xxx             # or the legacy "service_role" key
# CLAUDE_BIN=claude
# EXPLAINER_MODEL=sonnet          # default; opus for harder questions
# EXPLAINER_EFFORT=high
# EXPLAINER_WEB=true
# EXPLAINER_CONCURRENCY=2
# On servers/CI without an interactive login, authenticate Claude Code with a
# subscription token created by `claude setup-token`:
# CLAUDE_CODE_OAUTH_TOKEN=...
